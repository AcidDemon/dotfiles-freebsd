{{- $id := . -}}
# ~/.ssh/config

# ---------------------------------------------------------------------------
# Global defaults
# ---------------------------------------------------------------------------
Host *
    SetEnv TERM=xterm-256color
    UserKnownHostsFile ~/.ssh/known_hosts.d/known_hosts
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 10m
    AddKeysToAgent yes

# ---------------------------------------------------------------------------
# Git forges
# ---------------------------------------------------------------------------
Host github.com
    HostName github.com
    User git
    IdentitiesOnly yes
    IdentityFile ~/.ssh/github_ed25519

{{ trimSuffix "\n" $id.ssh.hosts }}
