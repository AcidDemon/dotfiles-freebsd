{{- $id := . -}}
default_profile = "default"

[macros.insert]
jj = "<Esc>"
jk = "<Esc>"

[macros.normal]
ZQ = ":qa!<CR>"
ZZ = ":qa<CR>"
gD = ":download<CR>"
gE = ":reply<CR>"
gR = ":react<Space>"
gc = ":chats<CR>"
gd = ":dms<CR>"
ge = ":edit<CR>"
gi = ":invite<Space>"
gm = ":members<CR>"
gr = ":rooms<CR>"
gs = ":spaces<CR>"
gu = ":unreads<CR>"
gv = ":verify<CR>"

[profiles.default]
user_id = "{{ $id.chat.matrix }}"

[settings]
log_level = "info"
message_user_color = true
reaction_display = true
reaction_shortcode_display = false
read_receipt_display = true
read_receipt_send = true
typing_notice_display = true
typing_notice_send = true
user_gutter_width = 30
username_display = "displayname"

[settings.image_preview.protocol]
type = "sixel"

[settings.image_preview.size]
height = 10
width = 66

[settings.notifications]
enabled = true
show_message = true
via = "desktop"

[settings.sort]
members = ["power", "localpart", "server"]
rooms = ["favorite", "unread", "recent", "lowpriority", "name"]
