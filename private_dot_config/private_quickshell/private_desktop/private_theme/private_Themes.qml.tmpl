{{- /* freebsd: generated by default.nix on nixos, same list: every theme sorted by id, colours plus borderFrom/borderTo */ -}}
{{- $list := list -}}
{{- range $id, $t := include "private_dot_config/private_theming/private_themes.json" | fromJson -}}
{{-   $colors := merge (dict "borderFrom" (index $t.border 0) "borderTo" (index $t.border 1)) $t.colors -}}
{{-   $list = append $list (dict "id" $id "name" $t.scheme "polarity" $t.polarity "muted" $t.muted "colors" $colors) -}}
{{- end -}}
pragma Singleton

import QtQuick
import Quickshell

Singleton {
    readonly property var list: {{ $list | toJson }}
}
