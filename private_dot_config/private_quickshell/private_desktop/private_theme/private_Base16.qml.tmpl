{{- /* freebsd: generated by default.nix on nixos; defaults are catppuccin-mocha on purpose, never the active theme, so a theme switch does not touch this file and restart the shell */ -}}
{{- $t := index (include "private_dot_config/private_theming/private_themes.json" | fromJson) "catppuccin-mocha" -}}
pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
{{- range $k, $_ := $t.colors }}
    readonly property color {{ $k }}: file.{{ $k }}
{{- end }}
    readonly property string scheme: file.scheme
    readonly property string polarity: file.polarity
    readonly property bool muted: file.muted

    FileView {
        path: "{{ .chezmoi.homeDir }}/.local/state/theming/palette.json"
        watchChanges: true
        blockWrites: true
        printErrors: false
        onFileChanged: reload()

        JsonAdapter {
            id: file
{{ range $k, $c := $t.colors }}
            property string {{ $k }}: "{{ $c }}"
{{- end }}
            property string scheme: "{{ $t.scheme }}"
            property string polarity: "{{ $t.polarity }}"
            property bool muted: {{ $t.muted }}
        }
    }
}
