{{- /* freebsd: generated by default.nix on nixos; ~/bin shims stand in for the nix store paths, "" = not on this host. keep the keys sorted */ -}}
{{- $h := .chezmoi.homeDir -}}
pragma Singleton

import QtQuick
import Quickshell

Singleton {
    readonly property string battery: "{{ $h }}/bin/qs-battery"
    readonly property string bluemanManager: ""
    readonly property string brightnessctl: "{{ $h }}/bin/qs-brightnessctl"
    readonly property string clipCopy: "{{ $h }}/bin/qs-clip-copy"
    readonly property string cliphist: "cliphist"
    readonly property string copy: "{{ $h }}/bin/qs-copy"
    readonly property string emojiData: "{{ $h }}/.config/quickshell/desktop/launcher/emoji.txt"
    readonly property string hiddenWindows: "quake"
    readonly property string hyprctl: ""
    readonly property string ip: ""
    readonly property string leds: ""
    readonly property string lock: "{{ $h }}/bin/qs-lock"
    readonly property string lockSuspend: ""
    readonly property string logout: "{{ $h }}/bin/qs-logout"
    readonly property string meminfo: "{{ $h }}/bin/qs-meminfo"
    readonly property string net: "{{ $h }}/bin/qs-net"
    readonly property string nightlight: "{{ $h }}/bin/qs-nightlight"
    readonly property string nmEditor: ""
    readonly property string nmcli: ""
    readonly property string notifySend: "notify-send"
    readonly property string obs: "{{ if lookPath "obs" }}obs{{ end }}"
    readonly property string osdIcons: ""
    readonly property string pactl: "pactl"
    readonly property string pavucontrol: "pavucontrol"
    readonly property string pwvucontrol: "pavucontrol"
    readonly property string qalc: "qalc"
    readonly property string screenshot: "{{ $h }}/bin/qs-screenshot"
    readonly property string systemctl: "{{ $h }}/bin/qs-systemctl"
    readonly property string systemdRun: "{{ $h }}/bin/qs-run"
    readonly property string temperature: "{{ $h }}/bin/qs-temperature"
    readonly property string terminal: "kitty"
    readonly property string themeSwitch: "{{ $h }}/bin/theme-switch"
    readonly property string udevadm: ""
    readonly property string vpn: "{{ $h }}/bin/qs-vpn"
    readonly property string vpnToggle: "{{ $h }}/bin/qs-vpn-toggle"
    readonly property string wallpaper: "{{ $h }}/bin/wallpaper"
    readonly property string wifiToggle: "{{ $h }}/bin/airplane-toggle"
}
