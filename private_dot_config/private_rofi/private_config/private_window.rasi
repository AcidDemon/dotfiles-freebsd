configuration {
    show-icons:                     true;
    display-run: 		            "";
    disable-history:                false;
    click-to-exit: 		            true;
    location:                       0;
}


@import "font.rasi"
@import "colors.rasi"

window {
    transparency:       "real";
    background-color:   @BG;
    text-color:         @FG;
    border:             2px;
    border-color:       @BDR;
    border-radius:      12px;
    width:              900px; 
    anchor:             center;
}

prompt {
    enabled:            true;
    padding:            8px;
    background-color:   transparent;
    text-color:         @IMG;
}

textbox-prompt-colon {
    expand:             false;
    str:                ""; 
    border-radius:      100%;
    background-color:   transparent;
    text-color:         @FG;
    padding:            8px 12px;
    font:               "IosevkaTerm Nerd Font 15";
}

entry {
    background-color:   transparent;
    text-color:         @FG;
    placeholder-color:  @FG;
    expand:             true;
    horizontal-align:   0;
    placeholder:        "Search windows…";
    blink:              true;
    border:             0px 0px 2px 0px;
    border-color:       @BDR;
    border-radius:      10px;
    padding:            8px;
}

inputbar {
    children:           [ textbox-prompt-colon, prompt, entry ];
    background-color:   transparent;
    text-color:         @FG;
    expand:             false;
    margin:             0;
    padding:            0;
    position:           center;
}

case-indicator {
    background-color:   transparent;
    text-color:         @FG;
    spacing:            0;
}

listview {
    background-color:   transparent;
    columns:            2;
    lines:              9;
    spacing:            6px;
    cycle:              false;
    dynamic:            true;
    layout:             vertical;
}

mainbox {
    background-color:   transparent;
    children:           [ inputbar, listview ];
    spacing:            15px;
    padding:            15px;
}

element {
    background-color:   transparent;
    text-color:         @FG;
    orientation:        horizontal;
    border-radius:      6px;
    padding:            8px;
    /* subtle separator */
    border:             1px;
    border-color:       transparent;
}

element-icon {
    background-color:   transparent;
    text-color:         inherit;
    horizontal-align:   0.5;
    vertical-align:     0.5;
    size:               24px;
    border:             0px;
    margin:             0px 8px 0px 2px;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    expand:             true;
    horizontal-align:   0;
    vertical-align:     0.5;
    margin:             0px 2px;
}

element normal.active,
element alternate.active {
    background-color:   @UGT; 
    text-color:         @SEL;
    border-color:       @BGA;
}

element selected.active {
    background-color:   @UGT;
    text-color:         @FG;
}

element normal.urgent,
element alternate.urgent {
    background-color:   @UGT;
    text-color:         @FG;
    border-radius:      9px;
}

element selected {
    background-color:   @BGA;
    text-color:         @SEL;
    border:             0px;
    border-radius:      10px;
}

element selected.urgent {
    background-color:   @UGT;
    text-color:         @FG;
}

element selected.active {
    background-color:   @BGA;
    text-color:         @SEL;
}

