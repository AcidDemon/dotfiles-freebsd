{{- /* icons from the active theme, like modules/theming/gtk; theme-switch relinks gtk.css to the widget theme's gtk-4.0 */ -}}
{{- $t := includeTemplate "theme" . | fromJson -}}
{{- $g := includeTemplate "gtk" (dict "t" $t "home" .chezmoi.homeDir) | fromJson -}}
[Settings]
gtk-cursor-theme-name=capitaine-cursors-light
gtk-cursor-theme-size=36
gtk-font-name=sans-serif 11
gtk-icon-theme-name={{ $g.icons }}
