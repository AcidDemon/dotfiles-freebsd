background {
  monitor=
  blur_passes=2
  color=0xff1e1e2e
  path={{ .chezmoi.homeDir }}/.config/hypr/assets/lock.jpg
}

general {
  hide_cursor=true
  ignore_empty_input=true
}

# Stacked clock: hours and minutes on their own lines, offset horizontally by
# half a digit width so the two blocks interlock. The y gap is about one cap
# height, so the lines nearly touch.
label {
  monitor=
  color=0xffcdd6f4
  font_family=Archivo Black
  font_size=140
  halign=center
  position=-23, 186
  text=cmd[update:30000] echo "$(date +"%H")"
  valign=center
}

label {
  monitor=
  color=0xffcba6f7
  font_family=Archivo Black
  font_size=140
  halign=center
  position=23, 53
  text=cmd[update:30000] echo "$(date +"%M")"
  valign=center
}

label {
  monitor=
  color=0xffa6adc8
  font_family=GeistMono Nerd Font
  font_size=18
  halign=center
  position=35, -35
  text=cmd[update:43200000] echo "$(date +"%d %B, %a.")"
  valign=center
}

image {
  monitor=
  size=180
  border_size=3
  border_color=0xffcba6f7
  rounding=-1
  halign=center
  path={{ .chezmoi.homeDir }}/.config/hypr/assets/avatar.png
  position=0, 250
  valign=bottom
}

label {
  monitor=
  color=0xffcdd6f4
  font_family=Archivo SemiBold
  font_size=22
  halign=center
  position=0, 190
  text=Hello, $USER
  valign=bottom
}

input-field {
  monitor=
  size=340, 60
  capslock_color=0xfff9e2af
  check_color=0xffcba6f7
  dots_center=true
  dots_size=0.200000
  dots_spacing=0.200000
  fade_on_empty=false
  fail_color=0xfff38ba8
  fail_text="<i>$FAIL <b>($ATTEMPTS)</b></i>"
  font_color=0xffcdd6f4
  halign=center
  hide_input=false
  inner_color=0xff313244
  outer_color=0xffcba6f7
  outline_thickness=3
  placeholder_text=Enter password...
  position=0, 110
  valign=bottom
}

# Submit affordance drawn inside the field: a rounded square with an arrow on
# top. Decorative only, hyprlock has no pointer interaction.
shape {
  monitor=
  size=40, 40
  color=0xff45475a
  border_size=1
  border_color=0xffcba6f7
  rounding=-1
  halign=center
  position=140, 120
  valign=bottom
  zindex=2
}

label {
  monitor=
  color=0xffcdd6f4
  font_family=Archivo SemiBold
  font_size=20
  halign=center
  position=140, 128
  text=→
  valign=bottom
  zindex=3
}

# Now playing. Empty when no MPRIS player is running, so the line just vanishes.
label {
  monitor=
  color=0xffa6adc8
  font_family=GeistMono Nerd Font
  font_size=15
  halign=center
  position=0, 55
  text=cmd[update:5000] {{ .chezmoi.homeDir }}/.config/hypr/nowplaying.sh
  valign=bottom
}
