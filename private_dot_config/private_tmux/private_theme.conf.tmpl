{{- /* catppuccin/tmux fed the active theme, like modules/cli/tmux/plugins.nix; sourced before tpm, theme-switch re-sources tmux.conf */ -}}
{{- $p := includeTemplate "theme" . | fromJson | includeTemplate "palette" | fromJson -}}
# subtext_1/0 swapped as in the plugin's Mocha file
set -g @thm_bg "{{ $p.base }}"
set -g @thm_fg "{{ $p.text }}"
set -g @thm_rosewater "{{ $p.rosewater }}"
set -g @thm_flamingo "{{ $p.flamingo }}"
set -g @thm_pink "{{ $p.pink }}"
set -g @thm_mauve "{{ $p.mauve }}"
set -g @thm_red "{{ $p.red }}"
set -g @thm_maroon "{{ $p.maroon }}"
set -g @thm_peach "{{ $p.peach }}"
set -g @thm_yellow "{{ $p.yellow }}"
set -g @thm_green "{{ $p.green }}"
set -g @thm_teal "{{ $p.teal }}"
set -g @thm_sky "{{ $p.sky }}"
set -g @thm_sapphire "{{ $p.sapphire }}"
set -g @thm_blue "{{ $p.blue }}"
set -g @thm_lavender "{{ $p.lavender }}"
set -g @thm_subtext_1 "{{ $p.subtext0 }}"
set -g @thm_subtext_0 "{{ $p.subtext1 }}"
set -g @thm_overlay_2 "{{ $p.overlay2 }}"
set -g @thm_overlay_1 "{{ $p.overlay1 }}"
set -g @thm_overlay_0 "{{ $p.overlay0 }}"
set -g @thm_surface_2 "{{ $p.surface2 }}"
set -g @thm_surface_1 "{{ $p.surface1 }}"
set -g @thm_surface_0 "{{ $p.surface0 }}"
set -g @thm_mantle "{{ $p.mantle }}"
set -g @thm_crust "{{ $p.crust }}"
