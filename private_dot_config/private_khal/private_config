[calendars]
[[personal]]
path = /home/acid/.local/state/calendars/personal/
color = '#89b4fa'
priority=10
type=calendar



[default]
default_calendar=personal
default_dayevent_duration=1d
default_event_duration=1h
enable_mouse=true
highlight_event_days=true
show_all_days=false

[keybindings]
delete=d
down=j,down
duplicate=p
export=e
left=h,left
new=n
quit=q,Q
right=l,right
search=/
today=t
up=k,up
view=tab

[locale]
dateformat=%x
datetimeformat=%c
default_timezone=
firstweekday=0
local_timezone=
longdateformat=%x
longdatetimeformat=%c
timeformat=%X
unicode_symbols=true
weeknumbers=off

