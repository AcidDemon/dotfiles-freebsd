# Suffix aliases: a bare filename opens with the command below

alias -s {md,markdown,txt,json,yaml,yml,toml,xml,csv}='bat'

alias -s {py,rb,js,ts,jsx,tsx}='bat'
alias -s {go,rs,c,cpp,h,hpp,java,scala,kt}='bat'
alias -s {html,css,scss,sass,less}='bat'

alias -s pdf='xdg-open'

alias -s {png,jpg,jpeg,gif,bmp,svg,webp,ico}='xdg-open'

alias -s {zip,tar,gz,bz2,xz,7z,rar,tgz}='ouch decompress'

alias -s {mp4,mkv,avi,mov,webm,flv}='xdg-open'
alias -s {mp3,flac,wav,ogg,m4a,aac}='xdg-open'
