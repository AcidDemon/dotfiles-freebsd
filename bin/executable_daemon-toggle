#!/bin/sh
# Start or stop a session daemon. pgrep -x, never a pkill pattern: `pkill waybar`
# once matched the session leader and killed the whole niri session.
set -eu

[ $# -ge 1 ] || { echo "usage: daemon-toggle <name> [args...]" >&2; exit 1; }
name=$1
shift

pids=$(pgrep -x "$name" || true)
if [ -n "$pids" ]; then
    kill $pids
    notify-send -a "$name" "$name stopped"
else
    /usr/sbin/daemon -f "$name" "$@"
    notify-send -a "$name" "$name started"
fi
